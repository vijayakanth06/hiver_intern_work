# ==============================================================================
# Hiver AI Customer Support Agent — Environment Configuration Template
# Copy this file to '.env' and fill in the values for your setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Ollama Configuration (Recommended for zero-cost, private inference)
# ------------------------------------------------------------------------------
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gpt-oss:20b
# Alternative local models: llama3.1:8b, qwen3.5:9b, cogito:14b

# ------------------------------------------------------------------------------
# 2. Cloud LLM API Keys (Optional if running Local Ollama)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# 3. Model Deployments
# ------------------------------------------------------------------------------
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_QUALITY_MODEL=llama-3.3-70b-versatile
OPENROUTER_JUDGE_MODEL=openai/gpt-4o-mini

# ------------------------------------------------------------------------------
# 4. Hardware & Concurrency
# ------------------------------------------------------------------------------
NUM_WORKERS=8
# Set to 'cuda' (NVIDIA), 'mps' (Apple Silicon), or 'cpu' (Universal)
DEVICE=auto

# ------------------------------------------------------------------------------
# 5. Resilience & Circuit Breakers
# ------------------------------------------------------------------------------
GROQ_TIMEOUT_SECONDS=15
OPENROUTER_TIMEOUT_SECONDS=30
CIRCUIT_BREAKER_FAILURES=5
MAX_RETRIES=3
